# Flask 開發設定
FLASK_ENV=development
FLASK_DEBUG=True
#可以不管 只要加入好友 看是否能收到訊息即可 功能給line組自己測試
# VIP 到店通知用 LINE Bot
# STAFF_LINE_CHANNEL_ACCESS_TOKEN：LINE Bot 的 Channel Access Token
# STAFF_LINE_USER_ID：接收 VIP 通知的店員 LINE User ID，多人請用逗號分隔，例如 U111...,U222...,U333...
STAFF_LINE_CHANNEL_ACCESS_TOKEN=
STAFF_LINE_USER_ID=

# 一般 LINE Bot 設定，未來會員互動功能會用到
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# LIFF App ID，註冊頁 register.js 會呼叫 GET /line/config 取得這個值再執行 liff.init()
# 去 LINE Developers Console 的 LIFF 分頁複製 LIFF ID 填入
LIFF_ID=

# 「我的會員／優惠券」用的第二個 LIFF App ID，Endpoint URL 設成 .../coupons
# 跟 LIFF_ID 是同一個 LINE Login channel 底下另外新增的一筆 LIFF App
LIFF_ID_COUPONS=

# POST /line/cron/vip-check 用的密鑰，Cloud Scheduler 呼叫時要帶在
# X-Cron-Secret header 裡；沒設定這支 API 一律回 403。自己隨便打一長串
# 隨機字串即可，不用跟別人一樣。
CRON_SECRET=

# 對外正式網址（Cloud Run），LINE 註冊連結會用這個組出 register_url
# 本機開發不用填，沒設定時會自動 fallback 用 request.url_root
# 正式環境（Cloud Run）要設成，結尾不要加 /：
# PUBLIC_BASE_URL=https://smart-member-296909390205.asia-southeast1.run.app
PUBLIC_BASE_URL=

# MySQL 資料庫設定
# 每個人依照自己電腦的 MySQL 設定填寫
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_member_system

# 雲端 MySQL 連線重用；連線池可減少每次重新握手的成本
DB_POOL_ENABLED=true
DB_POOL_SIZE=5
DB_CONNECTION_TIMEOUT=10



# 攝影辨識效能與散客建檔保護
# 人臉快取由背景更新，不會阻塞攝影串流
FACE_CACHE_REFRESH_INTERVAL=60
CAMERA_ANALYSIS_INTERVAL=0.15
GUEST_CONFIRM_REQUIRED=3
GUEST_STABILITY_TOLERANCE=0.45
VISITOR_REGISTRATION_MATCH_TOLERANCE=0.60
VISITOR_REGISTRATION_MIN_SHARPNESS=40
VISITOR_REGISTRATION_MIN_FACE_SIZE=80
RECENT_VISITOR_REGISTRATION_SECONDS=60

# Cloud Run 會員照片永久儲存。正式環境必須設定 bucket；
# 本機留空時會繼續使用專案內 member_images。
MEMBER_IMAGE_BUCKET=cki101-03
MEMBER_IMAGE_PREFIX=member_images
GOOGLE_CLOUD_PROJECT=cki101-03
PUBLIC_BASE_URL=https://smart-member-296909390205.asia-southeast1.run.app
